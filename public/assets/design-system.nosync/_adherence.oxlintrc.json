{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/_gen/**",
              "components/core/**",
              "components/game/**",
              "components/icons/**",
              "ui_kits/hud/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pixelify Sans|Silkscreen|Sora))/i]",
        "message": "Font not provided by the design system. Available: Pixelify Sans, Silkscreen, Sora."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|text|meta|key|ref|className|style|children)$/]",
        "message": "<LogEntry> doesn't accept that prop. Declared props: kind, text, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogEntry'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:xp|loot|info|warning|danger|drift)$/]",
        "message": "<LogEntry> kind must be one of 'xp' | 'loot' | 'info' | 'warning' | 'danger' | 'drift'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:corrupt|gold|success|warning|danger|neutral)$/]",
        "message": "<Badge> tone must be one of 'corrupt' | 'gold' | 'success' | 'warning' | 'danger' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|iconLeft|iconRight|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, iconLeft, iconRight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|gold|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'gold' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HotbarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|count|rarity|name|key|ref|className|style|children)$/]",
        "message": "<HotbarItem> doesn't accept that prop. Declared props: icon, count, rarity, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='HotbarItem'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:common|uncommon|rare|epic|legendary)$/]",
        "message": "<HotbarItem> rarity must be one of 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|glow|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, glow, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|kicker|accessory|corners|glow|padded|as|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, kicker, accessory, corners, glow, padded, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|count|keybind|rarity|selected|size|key|ref|className|style|children)$/]",
        "message": "<Slot> doesn't accept that prop. Declared props: icon, count, keybind, rarity, selected, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:common|uncommon|rare|epic|legendary)$/]",
        "message": "<Slot> rarity must be one of 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='XPBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:skill|level|value|max|color|icon|showNumbers|key|ref|className|style|children)$/]",
        "message": "<XPBar> doesn't accept that prop. Declared props: skill, level, value, max, color, icon, showNumbers."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
